# Copy this file to .env.contract. Never commit or send your private key in chat.
# Spicy is Chiliz's public testnet. Deploy here and test before choosing mainnet.
CHILIZ_RPC_URL=https://spicy-rpc.chiliz.com/
DEPLOYER_PRIVATE_KEY=

# Set this after a successful deployment. The web app will use it for reads/writes.
NEXT_PUBLIC_MATCHDAY_CONTRACT_ADDRESS=
NEXT_PUBLIC_CHILIZ_CHAIN_ID=88882
NEXT_PUBLIC_CHILIZ_RPC_URL=https://spicy-rpc.chiliz.com/
